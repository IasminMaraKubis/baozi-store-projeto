{
  "info": {
    "name": "Baozi Store - Trabalho Uninter",
    "description": "Execute na ordem. Primeiro substitua SEUNOME1234567 no POST cliente. Apague pedidos antes de cliente/produto. Capturar prints antes de exclusoes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Criar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"SEUNOME1234567\",\n  \"clienteDesde\": \"2026-11-23\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Criado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const id = pm.response.json().id; pm.test(\"ID gerado\", () => pm.expect(id).to.be.a(\"number\").above(0)); pm.collectionVariables.set(\"clienteId\", id); } else { pm.collectionVariables.unset(\"clienteId\"); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Criar produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi tradicional\",\n  \"preco\": 12.50,\n  \"estoque\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Criado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const id = pm.response.json().id; pm.test(\"ID gerado\", () => pm.expect(id).to.be.a(\"number\").above(0)); pm.collectionVariables.set(\"produtoId\", id); } else { pm.collectionVariables.unset(\"produtoId\"); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Criar pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Criado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const id = pm.response.json().id; pm.test(\"ID gerado\", () => pm.expect(id).to.be.a(\"number\").above(0)); pm.collectionVariables.set(\"pedidoId\", id); } else { pm.collectionVariables.unset(\"pedidoId\"); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
